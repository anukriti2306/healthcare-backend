# Copy this file to `.env` and adjust the values. `.env` is git-ignored.

# --- Django ---------------------------------------------------------------
# Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL -----------------------------------------------------------
DB_NAME=healthcare_db
DB_USER=healthcare_user
DB_PASSWORD=healthcare_pass
DB_HOST=localhost
DB_PORT=5432

# --- JWT ------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Misc -----------------------------------------------------------------
# Rate limit applied to register / login / token refresh (per client IP)
AUTH_THROTTLE_RATE=30/min
LOG_LEVEL=INFO
