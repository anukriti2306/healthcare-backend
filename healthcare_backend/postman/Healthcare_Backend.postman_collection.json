              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update patient (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "patients",
                "{{patient_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"age\": 43,\n  \"gender\": \"male\",\n  \"phone\": \"+91 98765 43210\",\n  \"address\": \"12 MG Road, Bengaluru\",\n  \"medical_history\": \"Hypertension\"\n}",
              "options": {
                "raw": {
