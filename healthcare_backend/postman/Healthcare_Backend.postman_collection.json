    {
      "name": "4. Patient-Doctor Mappings",
      "item": [
        {
          "name": "Assign doctor to patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/",
