            }
          ]
        },
        {
          "name": "Remove doctor from patient",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mappings/{{mapping_id}}/",
              "host": [
                "{{base_url}}"
